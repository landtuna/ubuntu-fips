# Build a Noble-based FIPS image. The attach config is mounted only for this
# RUN instruction and is not copied into the image.
FROM ubuntu:noble

RUN --mount=type=secret,id=pro-attach-config \
    set -eux; \
    apt-get update; \
    apt-get install --no-install-recommends -y \
        ca-certificates \
        ubuntu-pro-client; \
    pro attach --attach-config /run/secrets/pro-attach-config; \
    apt-get upgrade -y; \
    apt-get install --no-install-recommends -y \
        libgcrypt20 \
        openssh-client \
        openssh-server \
        openssh-sftp-server \
        openssl \
        openssl-fips-module-3 \
        strongswan; \
    pro detach --assume-yes; \
    apt-get purge --auto-remove -y \
        ca-certificates \
        ubuntu-pro-client; \
    rm -rf /var/lib/apt/lists/*
