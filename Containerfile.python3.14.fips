FROM ubuntu-noble-fips

USER root
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        locales \
    && locale-gen en_US.UTF-8 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/*

# The base image ships its UID-1000 account as "ubuntu".  Give it the
# requested name and home so all user-scoped tools live under /home/user.
RUN usermod --login user --home /home/user --move-home ubuntu \
    && groupmod --new-name user ubuntu \
    && usermod --append --groups sudo user \
    && rm -rf /tmp/*

# Keep both the interpreter and venv outside private home directories. Arbitrary
# runtime UIDs may execute them, but only root may modify the installation.
ENV UV_PYTHON_INSTALL_DIR="/opt/python"
RUN curl --silent --show-error --fail --location https://astral.sh/uv/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh \
    && uv python install 3.14 \
    && uv venv --python 3.14 /opt/venv \
    && uv pip install --python /opt/venv/bin/python pyright ruff \
    && chmod -R a+rX,go-w /opt/python /opt/venv \
    && rm -rf /root/.cache/uv /tmp/*

USER user

ENV PATH="/opt/venv/bin:/home/user/.local/bin:${PATH}"

ENTRYPOINT ["/opt/venv/bin/python"]
